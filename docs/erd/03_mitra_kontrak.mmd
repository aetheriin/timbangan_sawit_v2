erDiagram
    mitra {
        int id_supplier PK
        varchar kode_supplier UK
        varchar nama_supplier
        bit is_active
        datetime created_at
        nvarchar alamat "NULL"
    }
    mitra_peran {
        int id_supplier PK,FK
        varchar peran PK
    }
    mitra_company {
        int id_supplier PK,FK
        varchar id_company PK,FK
    }
    Company {
        varchar CompID PK
    }
    VehicleType {
        int VehicleTypeID PK
        varchar VehicleTypeCode UK
        nvarchar NameType
        bit Active
        decimal WeightCar "NULL"
        decimal MaxLoad "NULL"
        int Seat "NULL"
    }
    DetailVehicle {
        int IDVehicle PK
        varchar NoVehicle UK
        varchar NoSTNK UK
        int VehicleType FK "NULL"
        bigint BlacklistID FK "NULL"
        bit Active
        datetime CreateDate
    }
    VehicleDriver {
        int VehicleDriverID PK
        int IDVehicle FK
        bigint UserID FK
        bit IsMain
        bit Active
        bigint CreateBy FK "NULL"
        datetime CreateDate
        datetime UpdateDate
    }
    kontrak_kendaraan {
        int id_kontrak PK
        varchar no_kontrak "NULL"
        int id_kendaraan FK
        int id_supplier FK
        int id_produk FK "NULL"
        varchar jenis_transaksi "NULL"
        date tanggal_mulai
        date tanggal_selesai "NULL"
        bit is_active
        varchar keterangan "NULL"
        bigint created_by FK "NULL"
        datetime created_at
    }
    kontrak {
        int id_kontrak PK
        varchar no_kontrak UK
        varchar jenis_transaksi
        int id_customer FK
        int id_produk FK
        date tanggal
        decimal qty_kg "NULL"
        decimal harga_per_kg "NULL"
        varchar keterangan "NULL"
        bit is_active
        bigint created_by FK "NULL"
        datetime created_at
        bit ppn
        bit harga_termasuk_ppn
        varchar id_company FK "NULL"
    }
    delivery_order {
        int id_do PK
        varchar no_do UK
        int id_kontrak FK,UK
        date tanggal_do
        date berlaku_sampai "NULL"
        varchar keterangan "NULL"
        bit is_active
        bigint created_by FK "NULL"
        datetime created_at
    }
    do_pengangkutan {
        int id_do_angkut PK
        int id_do FK
        varchar cara_angkut
        int id_pengangkutan FK "NULL"
        decimal qty_kg "NULL"
        decimal ongkos_per_kg "NULL"
    }
    kelebihan_do {
        int id_kelebihan PK
        varchar no_tiket FK,UK
        varchar no_tiket_split FK
        int id_do FK
        decimal kuota_kg
        decimal realisasi_kg
        decimal netto_tiket_kg
        decimal kelebihan_kg
        varchar no_do_baru "NULL"
        varchar status
        nvarchar catatan "NULL"
        bigint diajukan_oleh FK "NULL"
        datetime diajukan_at "NULL"
        bigint ditetapkan_oleh FK "NULL"
        datetime ditetapkan_at "NULL"
        nvarchar alasan_kembali "NULL"
        bigint id_comp_area FK "NULL"
        datetime created_at
    }
    produk {
        int id_produk PK
        varchar nama_produk
        varchar kategori
        int id_alur FK
        bit is_active
    }
    standar_mutu {
        int id_produk PK,FK
        float maks_ffa
        float maks_air
        float maks_kotoran
    }
    alur {
        int id_alur PK
    }
    harga_harian {
        date tanggal PK
        decimal harga_cpo
        decimal harga_kernel
        decimal oer_cpo
        decimal biaya_olah
        bigint updated_by FK "NULL"
        datetime updated_at
    }
    Users {
        bigint UserID PK
    }
    kontrak ||--o| delivery_order : "id_kontrak"
    VehicleType |o--o{ DetailVehicle : "VehicleType"
    delivery_order ||--o{ do_pengangkutan : "id_do"
    mitra |o--o{ do_pengangkutan : "id_pengangkutan"
    delivery_order ||--o{ kelebihan_do : "id_do"
    Company |o--o{ kontrak : "id_company"
    mitra ||--o{ kontrak : "id_customer"
    produk ||--o{ kontrak : "id_produk"
    DetailVehicle ||--o{ kontrak_kendaraan : "id_kendaraan"
    produk |o--o{ kontrak_kendaraan : "id_produk"
    mitra ||--o{ kontrak_kendaraan : "id_supplier"
    Company ||--o{ mitra_company : "id_company"
    mitra ||--o{ mitra_company : "id_supplier"
    mitra ||--o{ mitra_peran : "id_supplier"
    alur ||--o{ produk : "id_alur"
    produk ||--o| standar_mutu : "id_produk"
    DetailVehicle ||--o{ VehicleDriver : "IDVehicle"