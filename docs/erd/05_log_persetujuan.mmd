erDiagram
    log_aktivitas {
        bigint id_log PK
        datetime2 waktu
        bigint id_user FK "NULL"
        bigint id_comp_area FK "NULL"
        varchar kategori
        varchar aksi
        varchar tabel "NULL"
        varchar id_baris "NULL"
        nvarchar nilai_lama "NULL"
        nvarchar nilai_baru "NULL"
        varchar ip "NULL"
        char hash_sebelum "NULL"
        char hash_baris
    }
    pengajuan {
        int id_pengajuan PK
        varchar jenis
        varchar status
        tinyint langkah
        tinyint total_langkah
        varchar id_company FK
        bigint id_comp_area FK
        varchar target
        nvarchar judul
        nvarchar alasan "NULL"
        nvarchar data "NULL"
        bigint diajukan_oleh FK
        datetime created_at
        datetime selesai_at "NULL"
        varchar kategori "NULL"
    }
    pengajuan_riwayat {
        int id_riwayat PK
        int id_pengajuan FK
        tinyint langkah
        varchar aksi
        int id_level FK "NULL"
        bigint id_user FK
        nvarchar catatan "NULL"
        datetime waktu
    }
    pengajuan_tahap {
        int id_pengajuan PK,FK
        tinyint urutan PK
        int id_level FK
    }
    alur_persetujuan {
        int id_alur_persetujuan PK
        varchar jenis
        varchar kategori "NULL"
        nvarchar keterangan "NULL"
        bit is_active
        datetime created_at
    }
    alur_persetujuan_tahap {
        int id_tahap PK
        int id_alur_persetujuan FK
        tinyint urutan
        int id_level FK
    }
    LevelDetails {
        int LevelDetID PK
        bigint CompAreaID FK "NULL"
        int LevelID FK
        varchar DeptID FK "NULL"
        varchar LevelDetCode UK
        nvarchar LevelDetName
        varchar HomeUrl
        nvarchar Description "NULL"
        bit Active
    }
    notifikasi {
        int id_notifikasi PK
        varchar kode_menu
        bigint id_comp_area FK "NULL"
        nvarchar judul
        nvarchar isi "NULL"
        varchar tautan "NULL"
        datetime waktu
        int id_level FK "NULL"
        varchar id_company FK "NULL"
        bigint id_user FK "NULL"
    }
    notifikasi_baca {
        int id_notifikasi PK,FK
        bigint id_user PK,FK
        datetime dibaca_at
    }
    Users {
        bigint UserID PK
    }
    CompanyArea {
        bigint CompAreaID PK
    }
    alur_persetujuan ||--o{ alur_persetujuan_tahap : "id_alur_persetujuan"
    LevelDetails ||--o{ alur_persetujuan_tahap : "id_level"
    CompanyArea |o--o{ LevelDetails : "CompAreaID"
    CompanyArea |o--o{ log_aktivitas : "id_comp_area"
    Users |o--o{ log_aktivitas : "id_user"
    CompanyArea |o--o{ notifikasi : "id_comp_area"
    LevelDetails |o--o{ notifikasi : "id_level"
    Users |o--o{ notifikasi : "id_user"
    notifikasi ||--o{ notifikasi_baca : "id_notifikasi"
    Users ||--o{ notifikasi_baca : "id_user"
    Users ||--o{ pengajuan : "diajukan_oleh"
    CompanyArea ||--o{ pengajuan : "id_comp_area"
    LevelDetails |o--o{ pengajuan_riwayat : "id_level"
    pengajuan ||--o{ pengajuan_riwayat : "id_pengajuan"
    Users ||--o{ pengajuan_riwayat : "id_user"
    LevelDetails ||--o{ pengajuan_tahap : "id_level"
    pengajuan ||--o{ pengajuan_tahap : "id_pengajuan"
    LevelDetails |o--o{ Users : "UserLevelID"