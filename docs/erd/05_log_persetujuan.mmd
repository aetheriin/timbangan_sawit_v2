erDiagram
    log_aktivitas {
        bigint id_log PK
        datetime2 waktu
        int id_user FK "NULL"
        int id_comp_area FK "NULL"
        varchar kategori
        varchar aksi
        varchar tabel "NULL"
        varchar id_baris "NULL"
        nvarchar nilai_lama "NULL"
        nvarchar nilai_baru "NULL"
        varchar ip "NULL"
        char hash_sebelum "NULL"
        char hash_baris
    }
    pengajuan {
        int id_pengajuan PK
        varchar jenis
        varchar status
        tinyint langkah
        tinyint total_langkah
        int id_company FK
        int id_comp_area FK
        varchar target
        nvarchar judul
        nvarchar alasan "NULL"
        nvarchar data "NULL"
        int diajukan_oleh FK
        datetime created_at
        datetime selesai_at "NULL"
    }
    pengajuan_riwayat {
        int id_riwayat PK
        int id_pengajuan FK
        tinyint langkah
        varchar aksi
        int id_level FK "NULL"
        int id_user FK
        nvarchar catatan "NULL"
        datetime waktu
    }
    notifikasi {
        int id_notifikasi PK
        varchar kode_menu
        int id_comp_area FK "NULL"
        nvarchar judul
        nvarchar isi "NULL"
        varchar tautan "NULL"
        datetime waktu
        int id_level FK "NULL"
        int id_company FK "NULL"
        int id_user FK "NULL"
    }
    notifikasi_baca {
        int id_notifikasi PK,FK
        int id_user PK,FK
        datetime dibaca_at
    }
    akun {
        int id_user PK
    }
    comp_area {
        int id_comp_area PK
    }
    comp_area |o--o{ log_aktivitas : "id_comp_area"
    akun |o--o{ log_aktivitas : "id_user"
    comp_area |o--o{ notifikasi : "id_comp_area"
    akun |o--o{ notifikasi : "id_user"
    notifikasi ||--o{ notifikasi_baca : "id_notifikasi"
    akun ||--o{ notifikasi_baca : "id_user"
    akun ||--o{ pengajuan : "diajukan_oleh"
    comp_area ||--o{ pengajuan : "id_comp_area"
    pengajuan ||--o{ pengajuan_riwayat : "id_pengajuan"
    akun ||--o{ pengajuan_riwayat : "id_user"