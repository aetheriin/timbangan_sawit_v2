erDiagram
    Company {
        varchar CompID PK
        nvarchar CompName
        nvarchar CompAddress "NULL"
        bit Active
        nvarchar Description "NULL"
        datetime CreateDate
    }
    Mill {
        bigint MillID PK
        varchar MillCode UK
        nvarchar MillName
        bit IsHeadOffice
        bit Active
        nvarchar Description "NULL"
        datetime CreateDate
    }
    CompanyArea {
        bigint CompAreaID PK
        varchar CompID FK
        bigint MillID FK "NULL"
        varchar AreaCode
        nvarchar AreaName
        nvarchar AreaDesc "NULL"
        nvarchar AreaAddress "NULL"
        bit Active
        datetime CreateDate
    }
    Department {
        varchar DeptID PK
        nvarchar DeptName UK
        nvarchar Description "NULL"
        bit Active
    }
    DepartmentDetails {
        bigint DeptDetailID PK
        bigint CompAreaID FK
        varchar DeptID FK
        nvarchar Location
        nvarchar Description "NULL"
        bit Active
    }
    Level {
        int LevelID PK
        nvarchar LevelName UK
        nvarchar Description "NULL"
        bit IsAdmin
        int SortOrder
        bit Active
    }
    LevelDetails {
        int LevelDetID PK
        bigint CompAreaID FK "NULL"
        int LevelID FK
        varchar DeptID FK "NULL"
        varchar LevelDetCode UK
        nvarchar LevelDetName
        varchar HomeUrl
        nvarchar Description "NULL"
        bit Active
    }
    Menu {
        int MenuID PK
        varchar MenuCode UK
        nvarchar MenuName
        nvarchar Description "NULL"
