erDiagram
    Company {
        varchar CompID PK
        nvarchar CompName
        nvarchar CompAddress "NULL"
        bit Active
        nvarchar Description "NULL"
        datetime CreateDate
    }
    Mill {
        bigint MillID PK
        varchar MillCode UK
        nvarchar MillName
        bit IsHeadOffice
        bit Active
        nvarchar Description "NULL"
        datetime CreateDate
    }
    CompanyArea {
        bigint CompAreaID PK
        varchar CompID FK
        bigint MillID FK "NULL"
        varchar AreaCode
        nvarchar AreaName
        nvarchar AreaDesc "NULL"
        nvarchar AreaAddress "NULL"
        bit Active
        datetime CreateDate
    }
    Department {
        varchar DeptID PK
        nvarchar DeptName UK
        nvarchar Description "NULL"
        bit Active
    }
    DepartmentDetails {
        bigint DeptDetailID PK
        bigint CompAreaID FK
        varchar DeptID FK
        nvarchar Location
        nvarchar Description "NULL"
        bit Active
    }
    Level {
        int LevelID PK
        nvarchar LevelName UK
        nvarchar Description "NULL"
        bit IsAdmin
        int SortOrder
        bit Active
    }
    LevelDetails {
        int LevelDetID PK
        bigint CompAreaID FK "NULL"
        int LevelID FK
        varchar DeptID FK "NULL"
        varchar LevelDetCode UK
        nvarchar LevelDetName
        varchar HomeUrl
        nvarchar Description "NULL"
        bit Active
    }
    Menu {
        int MenuID PK
        varchar MenuCode UK
        nvarchar MenuName
        nvarchar Description "NULL"
        int ParentMenuID FK "NULL"
        tinyint MenuLevel
        varchar Url "NULL"
        varchar Icon "NULL"
        varchar AppCode
        int SortOrder
        bigint CompAreaID FK "NULL"
        bit Active
    }
    ActionType {
        int ActionID PK
        varchar TypeName UK
        varchar Description "NULL"
        bit Active
    }
    AccessMenu {
        int AccessMenuID PK
        int MenuID FK
        int ActionID FK
        int LevelDetID FK "NULL"
        bigint UserID FK "NULL"
        bit Active
        datetime CreateDate
    }
    Users {
        bigint UserID PK
        bigint CompAreaID FK
        varchar UserCode "NULL"
        varchar UserName UK
        bigint UserDeptID FK "NULL"
        int UserLevelID FK
        char NoKTP "NULL"
        bigint GuestID "NULL"
        nvarchar Nama
        nvarchar Email "NULL"
        varbinary FaceEmbeddingData "NULL"
        nvarchar UploadPath "NULL"
        nvarchar CurrentHash "NULL"
        datetime CreateDate
        datetime UpdateDate
        bit Active
        bit IsUpload
        bigint BlacklistID "NULL"
        nvarchar Description "NULL"
        int PersonnelID FK,UK
        datetime LastLogin "NULL"
        int SessionVersion
    }
    PasswordManager {
        bigint UserID PK,FK
        varchar UserPasswd
        datetime CreateDate
        bit MustChange
        nvarchar History
        int Term "NULL"
        nvarchar Description "NULL"
    }
    UserCompany {
        bigint UserID PK,FK
        varchar CompID PK,FK
    }
    UserSession {
        varchar SessionID PK
        bigint UserID FK
        varchar IPAddress "NULL"
        varchar UserAgent "NULL"
        datetime LoginDate
        datetime LastActive
        datetime EndDate "NULL"
        varchar EndReason "NULL"
    }
    pengaturan {
        varchar kunci PK
        varchar nilai
        bigint updated_by FK "NULL"
        datetime updated_at
    }
    pengaturan_area {
        bigint id_comp_area PK,FK
        varchar kunci PK
        varchar nilai
        bigint updated_by FK "NULL"
        datetime updated_at
    }
    kolom_wajib {
        varchar form PK
        varchar kolom PK
    }
    perangkat_kiosk {
        varchar id_pos PK
        varchar nama
        varchar lokasi "NULL"
        char token_hash
        bigint id_comp_area FK
        bit is_active
        datetime created_at
    }
    jadwal_kerja {
        bigint id_comp_area PK,FK
        tinyint hari PK
        varchar nama_hari
        time jam_masuk "NULL"
        time jam_pulang "NULL"
        bit is_libur
        int toleransi_menit
    }
    personel {
        int id_personel PK
    }
    ActionType ||--o{ AccessMenu : "ActionID"
    LevelDetails |o--o{ AccessMenu : "LevelDetID"
    Menu ||--o{ AccessMenu : "MenuID"
    Users |o--o{ AccessMenu : "UserID"
    Company ||--o{ CompanyArea : "CompID"
    Mill |o--o{ CompanyArea : "MillID"
    CompanyArea ||--o{ DepartmentDetails : "CompAreaID"
    Department ||--o{ DepartmentDetails : "DeptID"
