        tinyint MenuLevel
        varchar Url "NULL"
        varchar Icon "NULL"
        varchar AppCode
        int SortOrder
        bigint CompAreaID FK "NULL"
        bit Active
    }
    ActionType {
        int ActionID PK
        varchar TypeName UK
        varchar Description "NULL"
        bit Active
    }
    AccessMenu {
        int AccessMenuID PK
        int MenuID FK
        int ActionID FK
        int LevelDetID FK "NULL"
        bigint UserID FK "NULL"
        bit Active
        datetime CreateDate
    }
    Users {
        bigint UserID PK
        bigint CompAreaID FK "NULL"
        varchar UserCode UK "NULL"
        varchar UserName UK "NULL"
        bigint UserDeptID FK "NULL"
        int UserLevelID FK "NULL"
        varchar CategoryCode FK
        varchar NoKTP UK "NULL"
        bigint GuestID "NULL"
        nvarchar Nama
        nvarchar Email "NULL"
        varbinary FaceEmbeddingData "NULL"
        nvarchar UploadPath "NULL"
        varchar CurrentHash "NULL"
        datetime CreateDate
        datetime UpdateDate
        bit Active
        bit IsUpload
        bigint BlacklistID FK "NULL"
        nvarchar Description "NULL"
        datetime LastLogin "NULL"
        int SessionVersion
    }
    PasswordManager {
        bigint UserID PK,FK
        varchar UserPasswd
        datetime CreateDate
        bit MustChange
        nvarchar History
        int Term "NULL"
        nvarchar Description "NULL"
    }
    UserCompany {
        bigint UserID PK,FK
        varchar CompID PK,FK
    }
    UserSession {
        varchar SessionID PK
        bigint UserID FK
        varchar IPAddress "NULL"
        varchar UserAgent "NULL"
        datetime LoginDate
        datetime LastActive
        datetime EndDate "NULL"
        varchar EndReason "NULL"
    }
    Setting {
        varchar SettingKey PK
        varchar SettingValue
        bigint UpdateBy FK "NULL"
        datetime UpdateDate
    }
    SettingArea {
        bigint CompAreaID PK,FK
        varchar SettingKey PK
        varchar SettingValue
        bigint UpdateBy FK "NULL"
        datetime UpdateDate
    }
    RequiredDataField {
        varchar FormCode PK
        varchar FieldName PK
    }
    Device {
        varchar DeviceID PK
        varchar DeviceName
        varchar Location "NULL"
        char TokenHash
        bigint CompAreaID FK
        bit Active
        datetime CreateDate
    }
    WorkSchedule {
        bigint CompAreaID PK,FK
        tinyint DayNo PK
        varchar DayName
        time TimeIn "NULL"
        time TimeOut "NULL"
        bit IsHoliday
        int ToleranceMinutes
    }
    UserCategory {
        varchar CategoryCode PK
    }
