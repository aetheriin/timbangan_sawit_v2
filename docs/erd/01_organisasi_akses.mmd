    Menu |o--o{ Menu : "ParentMenuID"
    Users ||--o| PasswordManager : "UserID"
    Users |o--o{ pengaturan : "updated_by"
    CompanyArea ||--o{ pengaturan_area : "id_comp_area"
    Users |o--o{ pengaturan_area : "updated_by"
    CompanyArea ||--o{ perangkat_kiosk : "id_comp_area"
    Company ||--o{ UserCompany : "CompID"
    Users ||--o{ UserCompany : "UserID"
    CompanyArea ||--o{ Users : "CompAreaID"
    personel ||--o| Users : "PersonnelID"
