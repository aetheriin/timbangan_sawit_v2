# ===== Wajib: nilai acak minimal 32 karakter (aplikasi menolak start bila masih contoh) =====
# Buat dengan:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=isi_dengan_random_string_panjang
HASH_SECRET_KEY=isi_dengan_random_string_panjang_lain

# ===== Database =====
DB_SERVER=nama_server_sql
DB_NAME=nama_database
# Akun SQL khusus aplikasi (database/keamanan/01_user_aplikasi.sql). Kosongkan = Windows Authentication.
DB_USER=
DB_PASSWORD=

# ===== Server (serve.py) =====
# 0.0.0.0 = bisa dibuka PC lain di LAN lewat http://<IP-PC-server>:5000
HOST=0.0.0.0
PORT=5000
THREADS=8

# ===== Keamanan =====
# Nilai di bawah adalah BAWAAN. Setelah migrasi 004, Admin > Pengaturan Site bisa mengubahnya tanpa restart
# (nilai dari Admin menang atas .env). Lihat docs/ADMIN.md.
# Logout otomatis bila tidak ada aktivitas (menit) & umur sesi maksimal (jam)
SESI_IDLE_MENIT=120
SESI_MAKS_JAM=12
# Kunci login: N kali salah password dalam JENDELA menit -> dikunci KUNCI menit
LOGIN_MAKS_GAGAL=5
LOGIN_JENDELA_MENIT=15
LOGIN_KUNCI_MENIT=15
# Jarak maksimal wajah dianggap sama (kecil = lebih ketat)
AMBANG_WAJAH=0.55
# Token bersama cara lama untuk kiosk di PC lain. Sebaiknya pakai token per pos: Admin > Perangkat / Kiosk.
# Kosong = hanya kiosk di PC server (atau pos yang terdaftar di menu Admin).
KIOSK_TOKEN=
# Setelah HTTPS (deploy/Caddyfile): BEHIND_PROXY=1 dan COOKIE_SECURE=1
BEHIND_PROXY=0
COOKIE_SECURE=0

# ===== Lainnya =====
WAJIB_SCAN_WAJAH=true
