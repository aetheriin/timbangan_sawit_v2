# Salin menjadi .env di folder ini, lalu isi.
# Alamat PC server (lihat ipconfig di PC server), port 5000
WEIGHBRIDGE_URL=http://192.168.1.10:5000
# Angka "ID agen" jembatan ini di Admin > Perangkat / Kiosk > Jembatan Timbang
JEMBATAN_ID=1
# Pos perangkat untuk PC ini di Admin > Perangkat / Kiosk (Tambah Pos), beserta tokennya
KIOSK_ID=POS-JT1
KIOSK_TOKEN=
